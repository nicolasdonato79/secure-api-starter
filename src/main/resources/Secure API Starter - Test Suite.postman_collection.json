    {
      "name": "Auth - Refresh",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Refresh OK (o 404 si no existe endpoint)', function () { pm.expect([200,404]).to.include(pm.response.code); });",
              "if (pm.response.code === 200) {",
              "  let data = pm.response.json();",
              "  if (data.accessToken) pm.environment.set('accessToken', data.accessToken);",
              "  if (data.refreshToken) pm.environment.set('refreshToken', data.refreshToken);",
              "}"
            ]
          }
        }
